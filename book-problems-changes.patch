+  stars: 0 | 1 | 2 | 3       // dificultad según Griffiths
+  statementEn: string        // transcripción literal (markdown + LaTeX)
+  statementEs: string        // traducción al español
+  footnotes: string[]        // notas al pie del libro adjuntas al problema
+}
