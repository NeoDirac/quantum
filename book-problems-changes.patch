+// statementEs: traducción al español (fiel al original; la matemática no cambia).
+// stars: dificultad según los asteriscos de Griffiths (0-3).
+// page: página impresa del libro (1.ª edición, Prentice Hall, 1995).
+
+export interface BookProblem {
+  id: string                 // 'bp-2-1'
+  number: string             // '2.1'
